{
  "expo": {
    "name": "Deckd",
    "slug": "deckd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F6F1",
    "ios": {
      "bundleIdentifier": "com.deckd.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "deckd"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.deckd.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F6F1"
      }
    },
    "extra": {
      "revenueCatIosApiKey": "",
      "revenueCatAndroidApiKey": ""
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F6F1"
        }
      ]
    ],
    "scheme": "deckd",
    "experiments": {
      "asyncRoutes": true
    }
  }
}
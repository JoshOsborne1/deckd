{
  "expo": {
    "name": "Deckd",
    "slug": "deckd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.deckd.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Deckd uses the camera to scan QR codes for multiplayer sessions.",
        "NSPhotoLibraryUsageDescription": "Deckd saves game screenshots to your photo library.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["deckd"]
          }
        ]
      }
    },
    "android": {
      "package": "com.deckd.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      }
    },
    "extra": {
      "revenueCatIosApiKey": "",
      "revenueCatAndroidApiKey": ""
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ]
    ],
    "scheme": "deckd"
  }
}

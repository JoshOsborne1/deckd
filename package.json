{
  "name": "deckd",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev-client": "expo start --dev-client",
    "build:ios-dev": "eas build --platform ios --profile development",
    "build:ios-prod": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev": "expo start --clear --lan --port 8082",
    "dev:web": "expo start --web --lan --port 8081 --clear",
    "dev:phone": "expo start --lan --dev-client --port 8082 --clear",
    "dev:tunnel": "expo start --tunnel --dev-client --port 8082 --clear",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npm run lint && npx expo-doctor",
    "build:android-dev": "eas build --platform android --profile development",
    "build:android-preview": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-purchases": "^10.0.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "ts-jest": "~29.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
